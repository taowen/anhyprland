diff --git a/src/os/Semaphore.cpp b/src/os/Semaphore.cpp
index 6877741..7cb870a 100644
--- a/src/os/Semaphore.cpp
+++ b/src/os/Semaphore.cpp
@@ -8,12 +8,23 @@
 #include <unistd.h>
 
 #include <format>
+#include <cstdlib>
+#include <cstring>
 
 using namespace Hyprutils;
 using namespace Hyprutils::OS;
 
 CSemaphore::CSemaphore(const char* name) {
+#ifdef __ANDROID__
+    const auto runtime = std::getenv("XDG_RUNTIME_DIR");
+    if (!runtime || !name || std::strchr(name, '/')) {
+        errno = EINVAL;
+        return;
+    }
+    m_fd = open(std::format("{}/hu_{}", runtime, name).c_str(), O_CREAT | O_RDWR | O_CLOEXEC | O_NOFOLLOW, 0600);
+#else
     m_fd = shm_open(std::format("/hu_{}", name).c_str(), O_CREAT | O_RDWR | O_CLOEXEC, 0600);
+#endif
 
     if (m_fd == -1)
         return;
