@@ -1,3 +1,42 @@
+#ifdef __ANDROID__
+#include "Svg.hpp"
+#include <lunasvg.h>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+
+using namespace Hyprutils::Math;
+
+std::expected<cairo_surface_t*, std::string> SVG::createSurfaceFromData(const std::span<const uint8_t>& data, const Vector2D& size) {
+    if (size.x < 1 || size.y < 1 || size.x > 16384 || size.y > 16384)
+        return std::unexpected("loading svg: invalid size");
+    auto document = lunasvg::Document::loadFromData(reinterpret_cast<const char*>(data.data()), data.size());
+    if (!document)
+        return std::unexpected("loading svg: LunaSVG failed to parse data");
+    auto bitmap = document->renderToBitmap(size.x, size.y);
+    if (bitmap.isNull())
+        return std::unexpected("loading svg: LunaSVG failed to render");
+    auto surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, bitmap.width(), bitmap.height());
+    if (cairo_surface_status(surface) != CAIRO_STATUS_SUCCESS) {
+        cairo_surface_destroy(surface);
+        return std::unexpected("loading svg: Cairo allocation failed");
+    }
+    auto destination = cairo_image_surface_get_data(surface);
+    const auto stride = cairo_image_surface_get_stride(surface);
+    for (int row = 0; row < bitmap.height(); ++row)
+        std::memcpy(destination + row * stride, bitmap.data() + row * bitmap.stride(), bitmap.width() * 4);
+    cairo_surface_mark_dirty(surface);
+    return surface;
+}
+
+std::expected<cairo_surface_t*, std::string> SVG::createSurfaceFromSVG(const std::string& path, const Vector2D& size) {
+    std::ifstream file(path, std::ios::binary);
+    if (!file)
+        return std::unexpected("loading svg: file inaccessible");
+    std::string data{std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>()};
+    return createSurfaceFromData(std::span<const uint8_t>{reinterpret_cast<const uint8_t*>(data.data()), data.size()}, size);
+}
